{% import '_message.html.twig' as message %}
{% set itinerary = this.itinerary %}

<section class="chat" {{ attributes.defaults(stimulus_controller('travel')) }}>
    {{ include('_chat_header.html.twig', { demo: demos.travel }) }}
    <div id="chat-body" class="chat-body">
        {% if itinerary %}
            <div class="itinerary">
                <h2 class="itinerary-title">{{ ux_icon('map-marker', { width: '28px', height: '28px' }) }} {{ itinerary.destination }}</h2>
                <p class="itinerary-summary">{{ itinerary.description }}</p>

                <div class="itinerary-facts">
                    <div class="itinerary-fact">
                        {{ ux_icon('calendar') }}
                        <strong>{{ itinerary.durationInDays }}</strong>
                        <span>{{ itinerary.durationInDays == 1 ? 'day' : 'days' }}</span>
                    </div>
                    <div class="itinerary-fact">
                        {{ ux_icon('budget') }}
                        <strong>{{ itinerary.budget }}</strong>
                        <span>budget</span>
                    </div>
                    <div class="itinerary-fact">
                        {{ ux_icon('highlight') }}
                        <strong>{{ itinerary.highlights|length }}</strong>
                        <span>highlights</span>
                    </div>
                </div>

                <h5 class="itinerary-heading">{{ ux_icon('compass') }} Trip highlights</h5>
                <div class="itinerary-highlights">
                    {% for highlight in itinerary.highlights %}
                        <span class="itinerary-highlight">{{ highlight }}</span>
                    {% endfor %}
                </div>

                <h5 class="itinerary-heading">{{ ux_icon('route') }} Day-by-day plan</h5>
                <ol class="itinerary-days">
                    {% for day in itinerary.days %}
                        <li class="itinerary-day">
                            <div class="itinerary-day-header">
                                <span class="itinerary-day-number">{{ day.dayNumber }}</span>
                                <strong>{{ day.theme }}</strong>
                            </div>
                            <ul class="itinerary-activities">
                                {% for activity in day.activities %}
                                    <li class="itinerary-activity">
                                        <span class="itinerary-time itinerary-time-{{ activity.time|lower }}">{{ activity.time }}</span>
                                        <span class="itinerary-activity-text">{{ activity.description }}</span>
                                        <span class="itinerary-cost">{{ ux_icon('wallet', { width: '14px', height: '14px' }) }} {{ activity.cost }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        {% else %}
            {{ message.welcome('Travel Planner', 'Describe your dream trip (destination, duration and budget class) and I generate a day-by-day itinerary - as structured output from Gemini.') }}
        {% endif %}
        <div id="loading-message" class="d-none">
            {{ message.user([{text:''}]) }}
            {{ message.bot('The Travel Bot is planning your trip ...', true) }}
        </div>
    </div>
    <div class="chat-composer" data-controller="chat-prompt">
        {% if not itinerary %}
            {{ include('_chat_prompts.html.twig', { prompts: ['A 3-day budget trip to Rome exploring historic sites', 'A 5-day luxury getaway in Bali', 'A moderate weekend in Lisbon with great food'] }) }}
        {% endif %}
        <form class="chat-form" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message" data-model="norender|message" type="text" class="chat-input" placeholder="Where do you want to travel?" autocomplete="off">
            <span class="chat-hint">↵ send</span>
            <button class="chat-send" aria-label="Send">{{ ux_icon('send') }}</button>
        </form>
    </div>
</section>
